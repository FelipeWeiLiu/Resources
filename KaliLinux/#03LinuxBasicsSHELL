** LINUX BASICS *
/* Shell 分为 Bash, Zsh, Dash以及Fish，Bash是常用的linux shell */



** SHELL **
free -m
//以mb为单位查看内存使用情况

top
//查看CPU进程

echo $SHELL
//查看目前使用的shell

chsh
//指定系统使用哪种shell
// chsh --shell /bin/bash

uname --all
//用于查看系统信息和内核，uname -r用于单独查看内核

netstat
//查看系统进程

systemctl list-unit-files --type=service --state=enabled -all
// -用来写段参数 --用来写长参数, 列出所有已启用服务

systemctl disable --now <nameoftheseservice> 
//用于禁用<指定服务>。

env
//用于查看环境变量
