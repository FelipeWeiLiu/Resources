.faq-container-simple {
  width: 900px;
  margin: 40px auto;
}

/* 主标题 */
.faq-container-simple h3 {
  font-size: 28px;
  color: #1c3870;
  border-bottom: 2px solid #00a4ff;
  padding-bottom: 8px;
  margin-bottom: 30px;
}

/* 每个分组 */
.faq-group {
  margin-bottom: 30px;
  border-left: 4px solid #1c3870;
  padding-left: 15px;
}

/* 分组标题🔥 */
.faq-group h4 {
  font-size: 20px;
  color: #1c3870;
  margin-bottom: 10px;
}

/* 内容框 */
.faq-box {
  background: #f8f9fb;
  padding: 15px 20px;
  border-radius: 8px;
  line-height: 1.6;
}
