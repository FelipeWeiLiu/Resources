SHELL OPERATORS

command &
//在后台运行command命令,此命令可以让linux同时进行多个进程，不影响命令实时控制。
//nmap 192.168.1.0/24 &

jobs
[1]+ Running sleep 100 &
//查看后台进程，[1]是任务编号，running运行中

fg
//把任务拉回前台，因为后台进程没办法进行交互。

kill %1
//结束后台进程编号1

command1 && command2 && command3
//先执行command1，在执行command2，最后command3

echo hey > welcome
//创建一个welcome.txt并输入hey，cat后得出输出值为hey。

echo hey2 >> welcome
//在welcome文件夹中追加hey2内容，最终输出为 hey hey2.

SIGTERM - 终止进程，但允许它提前完成一些清理任务
SIGKILL——终止进程——不做任何事后清理。
SIGSTOP - 停止/暂停进程
